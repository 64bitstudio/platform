# Ticket 049 (pivote GH Actions -> Jenkins) — plantilla de
# /home/ubuntu/secrets/jenkins/.env en la VM (real, gitignored, vive
# FUERA del checkout de git — mismo motivo que los .env.{dev,qa,prod}
# de auth-core-mc: un runner self-hosted limpia el workspace con
# "git clean" antes de cada checkout).
#
# Infra COMPARTIDA de la VM (no de un proyecto en particular) — por eso
# vive en /home/ubuntu/secrets/jenkins/, no en secrets/auth-core-mc/.

# Login inicial de administrador de Jenkins — CAMBIAR el password
# inmediatamente después del primer login (queda como el único usuario
# admin real, ver deploy/vm-infra/jenkins/casc/jenkins.yaml).
JENKINS_ADMIN_USER=marco
JENKINS_ADMIN_PASSWORD=

# Personal Access Token de GitHub -- ticket 006: RETIRADO como
# mecanismo real (ver GITHUB_APP_ID/GITHUB_APP_PRIVATE_KEY abajo).
# Hallazgo real que motivó el retiro: un PAT fine-grained, sin importar
# qué tan acotado, sigue autenticando como la cuenta de Marco -- que es
# owner de la organización -- así que sigue heredando el bypass de
# branch protection sin importar los permisos que se le quiten
# (probado en vivo, ver docs/ARQUITECTURA.md ticket 006). Se deja esta
# variable declarada (no borrada) por si algo necesita un fallback
# temporal durante la transición -- vacío = Jenkins arranca igual.
GITHUB_PAT=

# Ticket 006 (docs/definiciones/vault-secrets-manager-vm.md, HU-9):
# GitHub App "64bitstudio-jenkins-ci" -- reemplaza al PAT de arriba
# como mecanismo real de checkout/webhook/push. GITHUB_APP_ID no es
# secreto. La llave privada NO va en este archivo (es multilínea,
# rompería el formato línea-por-línea) -- vive en su propio archivo,
# /home/ubuntu/secrets/jenkins/github-app-private-key.pem (permisos
# 600), sincronizado desde Vault por el mismo paso de sync-vm-infra que
# ya mantiene esta plantilla al día. Generada por Marco a mano en la UI
# de GitHub (tampoco hay API para crear GitHub Apps) -- ver
# docs/ARQUITECTURA.md ticket 006 para los permisos exactos otorgados
# (Contents RW, Metadata RO, Commit statuses RW, Pull requests RO,
# Webhooks RW -- explícitamente SIN Administration).
GITHUB_APP_ID=

# SonarQube (misma instancia compartida de la VM que ya usa
# build-test-analyze en ci.yml — ver deploy/vm-infra/sonarqube/).
# "sonarqube" (no "localhost") -- Jenkins y Sonar son contenedores
# distintos, se alcanzan por nombre en la red compartida "vm-infra".
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=

# Notificaciones a Telegram (mismo bot/chat que ya usa ci.yml) —
# opcionales: si quedan vacías, el Jenkinsfile simplemente omite el paso
# de notificar, sin fallar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ticket 004 (docs/definiciones/vault-secrets-manager-vm.md, HU-3):
# SecretID del AppRole "jenkins-infra" de Vault -- el único bootstrap
# secret que sigue fuera de Vault por diseño (el RoleID no es secreto,
# vive en vars/corePipeline.groovy). Generado por
# deploy/vm-infra/vault/bootstrap-jenkins-approle.sh -- desde ese
# momento, sync-vm-infra ya NO deja vacíos GITHUB_PAT/SONAR_TOKEN/
# TELEGRAM_*  arriba: los renderiza en cada corrida leyéndolos de Vault
# (secret/jenkins), que pasa a ser la fuente de verdad.
VAULT_JENKINS_SECRET_ID=
